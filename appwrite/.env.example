# ------------------------------------------------------------------
# Appwrite connection settings
# Used by the provisioning script (setup-appwrite.mjs) and by the
# self-hosted MCP server config (mcp.json).
# ------------------------------------------------------------------

# Appwrite API base URL (must end in /v1).
#   Appwrite Cloud : https://cloud.appwrite.io/v1
#   Self-hosted    : http://localhost:9501/v1  (Docker, HTTP)
#                    https://appwrite.example.com/v1  (HTTPS)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Your Appwrite project ID (Project Settings -> Project ID in the Console)
APPWRITE_PROJECT_ID=your-project-id

# A server-side API key (Project Settings -> API Keys).
# Minimum scopes for provisioning: databases.read, databases.write,
# storage.read, storage.write.
APPWRITE_API_KEY=your-api-key

# Set to "true" ONLY for self-hosted Appwrite behind a self-signed
# TLS certificate. Leave "false" for Appwrite Cloud and normal setups.
APPWRITE_SELF_SIGNED=false
