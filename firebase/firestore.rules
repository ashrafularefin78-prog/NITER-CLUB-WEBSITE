rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- helpers ---------- */
    function signedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return signedIn() && userDoc().role == 'admin';
    }
    function execOf(clubId) {
      return signedIn() &&
        (userDoc().role == 'admin' || userDoc().role == 'executive') &&
        clubId in (userDoc().clubs == null ? [] : userDoc().clubs);
    }
    function isItStaff() {
      return signedIn() && userDoc().role == 'it-staff';
    }
    function isStaff() {
      return signedIn() &&
        (userDoc().role == 'admin' || userDoc().role == 'executive' || userDoc().role == 'it-staff');
    }

    /* ---------- site config (public read; admin write) ---------- */
    match /config/site {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ---------- clubs (public read; admin, or executive of that club) ---------- */
    match /clubs/{id} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || execOf(id);
      allow delete: if isAdmin();
    }

    /* ---------- notices ---------- */
    match /notices/{id} {
      allow read: if true;
      allow create: if isAdmin() || execOf(request.resource.data.clubId);
      allow update: if isAdmin() || execOf(resource.data.clubId);
      allow delete: if isAdmin() || execOf(resource.data.clubId);
    }

    /* ---------- forms ---------- */
    match /forms/{id} {
      allow read: if true;
      allow create: if isAdmin() || execOf(request.resource.data.clubId);
      allow update: if isAdmin() || execOf(resource.data.clubId);
      allow delete: if isAdmin() || execOf(resource.data.clubId);
    }

    /* ---------- submissions (anyone may apply; club staff may view) ----------
       Reads/updates are gated on the submission's OWN clubId field (not a form
       lookup) so club staff can query `where("clubId", ==, ...)` — Firestore
       rejects a query unless the rules can prove every returned doc is readable,
       and a get() on another doc defeats that proof. clubId is set from the
       form's clubId when a submission is created.
       A student may also read their own submissions (by uid or the email they
       filled the form with) so their dashboard shows their applications. */
    match /submissions/{id} {
      allow create: if true;
      allow read: if isAdmin() || execOf(resource.data.clubId) ||
        (signedIn() && (
          resource.data.userId == request.auth.uid ||
          resource.data.submitterEmail == request.auth.token.email
        ));
      allow update, delete: if isAdmin() || execOf(resource.data.clubId);
    }

    /* ---------- complaints (anyone may file; admins, club staff & admin-
       granted IT staff manage) ---------- */
    match /complaints/{id} {
      allow create: if true;
      allow read: if isAdmin() || isItStaff() || execOf(resource.data.clubId);
      allow update, delete: if isAdmin() || isItStaff() || execOf(resource.data.clubId);
    }

    /* ---------- memberships (junction table: student <-> club) ----------
       Students request to join (status == 'pending', own doc only — no
       self-approval). Club staff approve / reject, admins manage everything.
       A student may cancel their own still-pending request. Reads are limited
       to the requester or the club's staff/admins, which lets the app query
       per-user and per-managed-club and merge the results. */
    match /memberships/{id} {
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.clubId is string &&
        request.resource.data.status == 'pending';
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() || execOf(resource.data.clubId)
      );
      allow update: if isAdmin() || execOf(resource.data.clubId);
      allow delete: if isAdmin() || execOf(resource.data.clubId) ||
        (signedIn() && resource.data.userId == request.auth.uid && resource.data.status == 'pending');
    }

    /* ---------- events (public read; club staff & admins post) ----------
       Any signed-in student may RSVP or check themselves in: those actions only
       touch the rsvps / checkIns arrays of an event, so the rule narrows
       updates to exactly those keys (prevents editing the event itself). */
    match /events/{id} {
      allow read: if true;
      allow create: if isAdmin() || execOf(request.resource.data.clubId);
      allow update: if isAdmin() || execOf(resource.data.clubId) ||
        (signedIn() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvps', 'checkIns', 'waitlist']));
      allow delete: if isAdmin() || execOf(resource.data.clubId);
    }

    /* ---------- certificates (public read for /verify; issued on check-in) ---------- */
    match /certificates/{id} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    /* ---------- student Q&A board (public read; signed-in students post) ----------
       Anyone may add answers (only the answers array may change). The question
       author may flip status (close / mark answered) via their stored email key.
       Staff (admin / executive / it-staff) may additionally pin questions and
       hide spam answers — those moderation actions only touch the pinned* /
       hidden* fields (hiding an answer rewrites the answers array). */
    match /questions/{id} {
      allow read: if true;
      allow create: if signedIn() &&
        request.resource.data.authorKey is string &&
        request.resource.data.authorKey != '';
      allow update: if signedIn() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers']) ||
        (request.auth.token.email == resource.data.authorKey &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])) ||
        (isStaff() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned', 'pinnedAt', 'pinnedBy', 'status']))
      );
      allow delete: if isAdmin() ||
        (signedIn() && request.auth.token.email == resource.data.authorKey);
    }

    /* ---------- moderation warnings (staff only, append-only) ---------- */
    match /warnings/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    /* ---------- audit log (security transparency panel) ----------
       Append-only: any signed-in user may ADD rows (so failed logins from any
       device reach the shared trail), but only admins can read, and nobody can
       edit or delete a row once written. */
    match /auditLog/{id} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    /* ---------- ads (public read; club staff & admins publish) ---------- */
    match /ads/{id} {
      allow read: if true;
      allow create: if isAdmin() || execOf(request.resource.data.clubId);
      allow update, delete: if isAdmin() || execOf(resource.data.clubId);
    }

    /* ---------- user profiles ----------
       The very first account in the project becomes admin (it also creates
       the meta/bootstrap marker in the same batch, so it can only happen once).
       On create, a user may only be a plain member (no clubs) — executives are
       granted by an admin afterwards, which prevents privilege escalation. */
    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid && (
        (request.resource.data.role == 'admin' && !exists(/databases/$(database)/documents/meta/bootstrap)) ||
        (request.resource.data.role == 'member' &&
         'clubs' in request.resource.data &&
         request.resource.data.clubs.size() == 0)
      );
      allow update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'studentId']) ||
        isAdmin();
      allow delete: if isAdmin();
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    /* ---------- meta (bootstrap marker) ---------- */
    match /meta/{doc} {
      allow read: if true;
      allow create: if signedIn() && doc == 'bootstrap';
      allow update, delete: if false;
    }
  }
}
